# Godot Engine
# Ignore Godot editor settings and generated files
.godot/
.export/
.export_presets.cfg

# Import files generated by Godot (keep original assets, ignore generated .import files)
*.import
*.import/*

# Godot autogenerated uid files
*.uid

# Mono / C# (Godot Mono)
.mono/
.godot/mono/
.assembly_cache/

# Typical C# build folders
**/bin/
**/obj/
*.dll
*.pdb
*.mdb

# Rider / Visual Studio / VSCode
.vs/
.vscode/
.idea/
*.sln.user
*.csproj.user
*.user
*.userprefs
*.suo

# Exported builds / packages
*.exe
*.zip
*.pck
*.apk
*.aab

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Temp / backup / editor swap files
*.tmp
*.temp
*~
*.swp
*.lock
*.log

# Other caches
*.cache

# Keep the actual art and scene files tracked (do not ignore .png, .tscn, .cs, etc.)
# End of .gitignore
